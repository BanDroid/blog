<div class="mt-3 flow-root">
    <a href="{% if not paged.first %}{{ pagination.href.previous | url }}{% else %}javascript:void(0){% endif %}"
        class="float-left bg-primary/70 font-semibold py-2 px-4 rounded-full text-primary-foreground {% if not paged.first %}cursor-pointer hover:bg-primary{% else %}cursor-default opacity-50{% endif %}">Previous</a>
    <a href="{% if not paged.last %}{{ pagination.href.next | url }}{% else %}javascript:void(0){% endif %}"
        class="float-right bg-primary/70 font-semibold py-2 px-4 rounded-full text-primary-foreground {% if not paged.last %}cursor-pointer hover:bg-primary{% else %}cursor-default opacity-50{% endif %}">Next</a>
</div>