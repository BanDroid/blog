{%- set lazyImage =
"data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%201%201'%20height%3D'500'%20width%3D'960'%20style%3D'background-color%3Argb(203%2C213%2C224)'%2F%3E"
-%}
{% for post in paged.posts %}
<div class="w-full sm:w-1/2 md:w-1/3 self-stretch p-2 mb-2">
    <article onclick="window.location.href = '{{ post.url | url }}'"
        class="block bg-surface dark:bg-surface h-full opacity-90 hover:opacity-100 cursor-pointer">
        <div>
            <img class="w-full m-0 lazy rounded-lg overflow-hidden" src="{{ lazyImage }}"
                data-src="{% if post.data.thumb %}{{ post.data.thumb | url }}{% else %}{{ '/assets/img/no-image.svg' | url }}{% endif %}"
                width="960" height="500" alt="This post thumbnail">
        </div>
        <div class="px-4 ps-2 py-4">
            <div class="font-semibold text-lg mb-2">
                <h5 href="{{ post.url | url }}">{{ post.data.title }}</h5>
            </div>
            <p class="text-foreground/50 mb-1 text-xs" title="Published date">{{ post.data.page.date | readableDate }}
            </p>
            <p class="text-foreground/80">
                {% if post.data.description %}
                {{ post.data.description }}
                {% else %}
                {{ post.templateContent | striptags | truncate(90, true) }}
                {% endif %}
            </p>
            <div class="py-2 space-2">
                {% for tag in post.data.tags %}
                <a href="/tags/{{tag}}"
                    class="bg-primary/50 hover:bg-primary text-primary-foreground text-xs rounded-full px-2 py-1">#{{tag}}</a>
                {% endfor %}
            </div>
        </div>
    </article>
</div>
{% endfor %}